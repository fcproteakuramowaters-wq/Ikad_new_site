# Example environment variables for this project
# Copy values into Vercel (Project → Settings → Environment Variables)
# Do NOT commit real secrets to source control.

# Email configuration (server-only)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com

# Hotel email addresses
VICTORIA_ISLAND_EMAIL=victoria@example.com
YABA_EMAIL=yaba@example.com
ADMIN_EMAIL=admin@example.com

# Notes:
# - These variables are used only on the server. Do NOT prefix them with NEXT_PUBLIC_.
# - In Vercel, set each variable with the correct value and scope (Production, Preview, Development).
# - After adding production values in Vercel, redeploy the project so your API route picks them up.
